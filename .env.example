# Copy to .env on the VPS (chmod 600). Never commit .env.

# ---- Mode ---------------------------------------------------------------
# true = print/log alerts instead of sending WhatsApp messages
DRY_RUN=true
LOG_LEVEL=INFO
DATA_DIR=/data

# ---- Telegram (my.telegram.org -> API development tools) ----------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Your phone with country code, used only for the one-time login
TELEGRAM_PHONE=
TELEGRAM_SESSION=/data/telegram
# Public groups to read by username (comma-separated). No joining.
TELEGRAM_GROUPS=h1bh4_dropbox_visa_slots,StrictlyH1_H4_regular_visa_slots,Regular_H1B_H4_VisaSlotsChecking
TELEGRAM_POLL_SECONDS=25

# ---- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=
# Cheapest current vision-capable model; change here if needed
OPENAI_MODEL=gpt-6-luna
# Used automatically only if the main model is unavailable (e.g. retired)
OPENAI_FALLBACK_MODEL=gpt-6.1-terra
AI_TIMEOUT_SECONDS=10
# Screenshots take 2-7s to read; allow more before giving up
AI_IMAGE_TIMEOUT_SECONDS=20

# ---- Alerts: your own Telegram bot (main channel) ------------------------
# Token from @BotFather. Chats: name|chat_id, comma-separated (get IDs with: python -m watcher bot-chats)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHATS=

# ---- Optional: feed bot (a second bot that silently copies EVERY message read + the decision) --
# Leave empty to turn off. Chats default to the first TELEGRAM_ALERT_CHATS entry.
TELEGRAM_FEED_BOT_TOKEN=
TELEGRAM_FEED_CHATS=

# ---- Optional: WhatsApp via CallMeBot (unofficial, off unless filled) -----
# Comma-separated list of name|+countrycodephone|apikey (each person activates CallMeBot themselves)
# e.g. WHATSAPP_RECIPIENTS=me|+10000000000|123456,family|+15555555555|654321
WHATSAPP_RECIPIENTS=
# Minimum seconds between messages to the same number
CALLMEBOT_MIN_GAP_SECONDS=10

# ---- CheckVisaSlots (public page only) ----------------------------------
# Off by default: the site currently serves a bot checkpoint to scripts (see README).
CVS_ENABLED=false
CVS_BROWSER_HEADED=true
# Optional silent success message after every check. Failures/recovery always notify.
CVS_FEED_CHECK_SUMMARIES=false
CVS_MAX_ALERT_AGE_MINUTES=5
# Checks are timed to just after each site refresh (about every 2 minutes);
# two checks never start closer than CVS_MIN_GAP_SECONDS apart.
CVS_REFRESH_SECONDS=120
CVS_MIN_GAP_SECONDS=115
# Set false with CVS_MIN_GAP_SECONDS=300 for a fixed five-minute trial.
CVS_SYNC_CHECKS=true
# Experimental CDP prefetch filtering/traffic measurements; off for overnight baseline behavior.
CVS_NETWORK_CONTROLS_ENABLED=false

# ---- Housekeeping -------------------------------------------------------
# First zone gets the date; add America/New_York etc. for recipients abroad
DISPLAY_TIMEZONES=Asia/Kolkata,America/New_York
HEARTBEAT_TIME_IST=09:00
SOURCE_FAIL_ALERT_MINUTES=15
DUPLICATE_SUMMARY_WINDOW_SECONDS=120
# Never alert on posts older than this (e.g. backlog after downtime)
MAX_ALERT_AGE_MINUTES=30
# Same person posting the same text (or same screenshot) in several groups within this window = one alert
SAME_SENDER_WINDOW_SECONDS=300
